{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "affiliate-getbee-app",
	"account_id": "81cac75fe318d80f4344481afc4799ac",
	"compatibility_date": "2026-01-10",
	"compatibility_flags": [
		"nodejs_als",
		"nodejs_compat"
	],
	// Wraps the adapter's generated worker to add a scheduled handler; see worker.js.
	"main": "worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	"workers_dev": true,
	"preview_urls": true,
	"triggers": {
		// 03:00 UTC: full Partner API sync. Hourly: lifecycle email outbox only.
		"crons": ["0 3 * * *", "0 * * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bee-affiliates",
			"database_id": "121208c4-e705-4870-9f81-21bc24ed4e19",
			"migrations_dir": "drizzle"
		}
	],
	"vars": {
		"NODE_ENV": "production",
		"APP_URL": "https://affiliates.getbee.app",
		"APP_NAME": "Bee Affiliates",
		"EMAIL_API_URL": "https://tools.capaxe.com/email",
		"EMAIL_FROM": "Bee Affiliates <affiliates@getbee.app>",
		// Default Partner API version for newly connected accounts.
		"PARTNER_API_VERSION": "2026-07"
	},
	"routes": [
		{ "pattern": "affiliates.getbee.app", "custom_domain": true }
	]

	// Secrets (set with `wrangler secret put <NAME>`):
	//   EMAIL_API_KEY     — tools.capaxe.com/email api key
	//   PARTNER_ORG_ID    — Shopify Partner organization id
	//   PARTNER_API_TOKEN — Shopify Partner API access token
	//   CRON_SECRET       — bearer token for POST /api/cron/sync
	//   ENCRYPTION_KEY    — passphrase used to encrypt Partner API tokens in D1
	//
	// Scheduling: adapter-cloudflare only exports a fetch handler, so there is no
	// scheduled() hook. Point any scheduler at POST /api/cron/sync with
	// `Authorization: Bearer $CRON_SECRET` to run the Partner API sync hourly.
}
